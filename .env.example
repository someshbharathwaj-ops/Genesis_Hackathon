# Environment Configuration for Recall
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Recall"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + pgvector)
# Use SQLite in-memory or Postgres URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recall_db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Security / Auth
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM / Primary Model Adapter
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=15.0
USE_MOCK_LLM=true

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
